---
import type { MarkdownHeading } from 'astro';

interface Props {
  /** Markdown 標題清單：取自 Astro MarkdownInstance 的 getHeadings() */
  headings: MarkdownHeading[];
  /** TOC 最小層級（h1 通常是頁面標題，預設從 h2 開始） */
  minDepth?: number;
  /** TOC 最大層級（抓太深右欄會擠爆） */
  maxDepth?: number;
  /** 小標與 aria-label 文字 */
  label?: string;
}

const { headings = [], minDepth = 2, maxDepth = 3, label = '本頁大綱' } = Astro.props;

// Astro 的 heading.text 可能帶著 markdown 語法（`code`、**粗體**、[文字](網址)），TOC 只显示純文字
const toPlainText = (text: string) =>
  text
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`~]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

// slug 就是標題的 id（Astro 產生，重複標題會自動加 -1）；這裡再防堵一次重複
const taken = new Set<string>();
const items: { slug: string; label: string; depth: number }[] = [];
for (const heading of headings) {
  if (heading.depth < minDepth || heading.depth > maxDepth) continue;
  if (!heading.slug || taken.has(heading.slug)) continue;
  taken.add(heading.slug);
  items.push({ slug: heading.slug, label: toPlainText(heading.text) || heading.slug, depth: heading.depth });
}
// 文件跳級（h2 直接接 h4）時，以「實際最淺層級」當縮排基準才不會出現大片空白
const baseDepth = items.length ? Math.min(...items.map((item) => item.depth)) : minDepth;
---

{
  items.length > 0 && (
    <nav class="toc" aria-label={label} data-toc>
      <h2 class="toc-caption">{label}</h2>
      <ul class="toc-list">
        {items.map((item) => {
          const level = Math.min(2, Math.max(0, item.depth - baseDepth));
          return (
            <li>
              <a class:list={['toc-link', `toc-depth-${level}`]} href={`#${item.slug}`} data-toc-link>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

<script>
  // 滾動高亮：TOC 與本頁標題一比一對映（slug 就是標題 id），不需要額外的 observer 設定
  const toc = document.querySelector<HTMLElement>('[data-toc]');

  if (toc) {
    const pairs: { link: HTMLAnchorElement; target: HTMLElement }[] = [];
    for (const link of toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) {
      const id = decodeURIComponent(link.getAttribute('href')?.replace(/^#/, '') ?? '');
      const target = id ? document.getElementById(id) : null;
      if (target) pairs.push({ link, target });
    }

    if (pairs.length > 0) {
      let frame = 0;
      let current: HTMLAnchorElement | null = null;

      const update = () => {
        frame = 0;
        // ≤1200px 時右欄是 display:none，不必做無效計算；放大回桌面後下一次事件會自然補回
        if (toc.offsetParent === null) return;
        // 標題頂部通過此視窗座標線即視為「目前已進入」該章節；預留 mobile topbar 高度
        const marker = 96;
        let active: HTMLAnchorElement | null = null;
        for (const { link, target } of pairs) {
          if (target.getBoundingClientRect().top <= marker) active = link;
          else break;
        }
        // 頁面還在最頂部時 highlight 第一項，避免整欄都沒有狀態
        if (!active) active = pairs[0].link;
        if (active === current) return;

        current = active;
        for (const { link } of pairs) {
          const isActive = link === active;
          link.classList.toggle('is-active', isActive);
          if (isActive) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }

        // TOC 很長時，讓目前章節維持在 TOC 自己的可視範圍內（只捲 TOC，不影響主內容）
        const linkRect = active.getBoundingClientRect();
        const tocRect = toc.getBoundingClientRect();
        if (linkRect.top < tocRect.top || linkRect.bottom > tocRect.bottom) {
          toc.scrollTop += linkRect.top - tocRect.top - tocRect.height / 2 + linkRect.height / 2;
        }
      };

      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      update();
    }
  }
</script>

<style>
  .toc {
    font-size: 0.875rem;
  }
  .toc-caption {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted, #6b7280);
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border-color, #e5e7eb);
  }
  .toc-list li {
    margin: 0;
  }
  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 0.35rem 0.5rem;
    border-left: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    color: var(--text-color, #374151);
    text-decoration: none;
    line-height: 1.45;
    word-break: break-word;
  }
  .toc-link:hover {
    color: var(--link-color, #2563eb);
    background-color: rgba(0, 0, 0, 0.04);
  }
  /* 層級縮排（放在基礎樣式之後，避免同特異性被蓋掉） */
  .toc-depth-1 {
    padding-left: 1.15rem;
    font-size: 0.94em;
  }
  .toc-depth-2 {
    padding-left: 1.85rem;
    font-size: 0.9em;
  }
  .toc-link.is-active {
    color: var(--link-color, #2563eb);
    font-weight: 700;
    border-left-color: var(--link-color, #2563eb);
    background-color: rgba(37, 99, 235, 0.08);
    background-color: color-mix(in srgb, var(--link-color, #2563eb) 10%, transparent);
  }
</style>
