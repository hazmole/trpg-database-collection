---
import GameLayout from '../../layouts/GameLayout.astro';
import type { MdItem } from '../../types';
import { getConfig, getConfigColle } from '../../utils/games';

export async function getStaticPaths() {
  const colle = getConfigColle()
  const paths = colle.map(cfg => {
    return { params: { game: cfg.key } };
  });
  return paths;
}

const { game } = Astro.params;

let gameConfig = {};
let gameTitle = "";
let post: MdItem | null = null;

try {
  const cfg = getConfig(game);
  if(cfg) {
    gameConfig = cfg;
    gameTitle = cfg.title;
  }
  
  const files: Record<string, MdItem> = import.meta.glob("../../collections/**/introduction.md", { eager: true });
  const postKey = Object.keys(files).find(p => p.includes(`/${game}/`)) || "";
  if (postKey) post = files[postKey];
} catch (e) {}

const { Content } = post || {};

---

<GameLayout game={game} title={gameTitle} config={gameConfig}>
  <div class="markdown-body">
    <h1>{gameTitle} 規則資料庫</h1>
    {Content ? <Content /> : <p>歡迎來到 {gameTitle} 規則庫，請從左側選單選擇想查閱的項目。</p>}
  </div>
</GameLayout>

<style>
  .markdown-body { line-height: 1.7; }
</style>